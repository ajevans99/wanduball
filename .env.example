# Leave empty for local practice. Get real values from Supabase Project Settings > API.
# These two values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, paste into chat, or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Set only in Vercel Production to open the live room at /. Redeploy after changing.
# Leave unset for previews and local development.
DEFAULT_ROOM_ID=
